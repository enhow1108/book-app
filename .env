# Not secret: public address of our ISBN lookup server (src/app/api/isbn+api.ts on EAS Hosting).
EXPO_PUBLIC_ISBN_API_URL=https://enhow1108-book-app.expo.app
# Not secret either, once restricted in Google Cloud to the Books API and to our web address and app.
# Lets the app look up books and find covers without running into Google's shared daily limit.
# EXPO_PUBLIC_GOOGLE_BOOKS_KEY=
